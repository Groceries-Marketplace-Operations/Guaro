// ============================================================================
// Prisma Schema — Task / Workflows System
// Source of truth. Equivalent to schema.sql + 002.
//
// Notes:
//   - updated_at is managed with @updatedAt (app-level), not a DB trigger.
//   - CHECK constraints and the composite FK for country (same country app<->brand)
//     are not expressed by Prisma: they go in constraints.sql, run AFTER migrate.
//   - step_definition_account added: pool of candidates to assign a step
//     (1 if fixed, multiple if RR / by_weight).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------- Enums ----------------------------------------
enum Country {
  CO
  MX
  CR
}

enum DidiBindingEnvironment {
  TEST
  PRODUCTION
}

enum DidiStoreBindingAction {
  bind
  unbind
}

enum DidiStoreBindingItemStatus {
  pending
  processing
  submitting
  success
  failed
  unconfirmed
  cancelled
}

enum AccountRole {
  user
  bpo
  admin
  super_admin
  director

  @@map("AccountRol")
}

enum ExecutionType {
  manual_external
  manual_internal
  automatic

  @@map("TipoEjecucion")
}

enum AssignmentStrategy {
  fixed
  round_robin
  by_weight // on hold — not used in code; kept for DB compatibility
  brand_assignment // assign via BrandAssignmentRule (ka_type × country)
  manual // admin selects BPO at runtime
  same_previous_step // assign the same BPO who worked the previous step

  @@map("EstrategiaAsignacion")
}

enum AssignmentMode {
  fixed
  round_robin

  @@map("AsignacionModo")
}

enum FormFieldTipo {
  link
  link_spreadsheet
  texto
  text_box // multi-line free text area
  numero
  select
  select_brand
  multiple_brands // multi-select: one FormValue row per brand
  select_store
  select_ka_type // dropdown populated from AppConfig category=ka_type
  select_country // dropdown populated from AppConfig category=country
  select_biz_category // dropdown populated from AppConfig category=biz_category
  file // Excel upload (.xlsx/.xls); stored as temp filename, deleted after handler runs
  image // JPG/PNG/GIF upload used by automatic store-information tasks
}

enum WebhookEvent {
  on_start
  on_complete
  on_fail
  on_assignment
  on_blocked

  @@map("WebhookEvento")
}

enum TaskStatus {
  scheduled
  pending
  assigned
  in_progress
  blocked
  failed
  done

  @@map("TaskEstado")
}

enum StepStatus {
  pending
  in_progress
  blocked
  failed
  done
  cancelled

  @@map("StepEstado")
}

enum StepFailureReason {
  system_timed_out
  bpo_timed_out
  no_bpo
  error_handler

  @@map("StepMotivoFallo")
}

enum KaType {
  KA
  CKA
  SME
}

enum MenuIntegration {
  api
  api_whitelist
  sftp
  spreadsheets
  bapp
}

enum PickingMode {
  merchant_picking_bapp
  merchant_picking_dapp
  dos_en_uno
}

enum PaymentMode {
  food_mode
  prepaid_card
  qr_code
}

enum ShopPickingModel {
  store_picking
  qr_code_2in1
  prepaid_card_2in1
}

enum ShopStatus {
  lead
  application
  integrated
  online
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("DiaSemana")
}

enum AutoOpenStatus {
  pending
  running
  done
  partial_success
  failed
  cancelled

  @@map("AutoOpenEstado")
}

enum DidiOrderWebhookStatus {
  processing
  accepted
  failed
}

enum DidiOrderWebhookRequestStage {
  received
  validation
  shop_resolution
  idempotency
  authentication
  confirmation
  completed
  legacy
}

enum DidiOrderWebhookRequestOutcome {
  processing
  accepted
  deduplicated
  rejected
  failed
}

enum AutoFetchKind {
  stores
  menu
}

enum FileIntegrationKind {
  complex_promotion_reader
  price_filter
  store_file_splitter
  daily_status_activation
}

enum PromotionApiMode {
  dry_run
  live
}

enum StoreOnboardingSource {
  create
  duplicate
  manual
}

enum StoreOnboardingStatus {
  active
  partial_success
  done
  blocked
  cancelled
}

enum StoreOnboardingStage {
  created
  awaiting_shop_ids
  awaiting_configuration_brief
  integration_queued
  configuring
  configuration_validated
  audit_preparing
  awaiting_audit
  audit_needs_information
  audit_rejected
  audit_approved
  rtbo
  integration_complete
  awaiting_go_live
  going_online
  online
  online_failed
  no_coverage
  creation_failed
  blocked
  cancelled
}

enum StoreOnboardingAuditStatus {
  pending
  needs_information
  approved
  rejected
}

enum StoreOnboardingEtaConfidence {
  low
  medium
  high
}

enum StoreOnboardingGoLiveSource {
  manual
  auto_open
  forced_open
}

enum StoreOnboardingGoLiveStatus {
  running
  done
  failed
}

enum StoreOnboardingEnrollmentDecision {
  enrolled
  excluded
}

enum BrandProvisioningStatus {
  pending
  ready
  failed
  cancelled
}

enum TaskDependencyStatus {
  waiting
  satisfied
  failed
  cancelled
}

enum StoreOnboardingNotificationFrequency {
  immediate
  digest
  scheduled
}

enum StoreOnboardingOutboxStatus {
  pending
  processing
  dispatched
  suppressed
  failed
}

enum StoreOnboardingDeliveryStatus {
  pending
  processing
  retry_wait
  delivered
  failed
  suppressed
}

// ---------------------------- Actors ---------------------------------------
model Account {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @map("nombre")
  email          String        @unique
  googleSub      String?       @unique @map("google_sub")
  roles          AccountRole[]
  adminModules   String[]      @default([]) @map("admin_modules")
  bpoPermissions String[]      @default([]) @map("bpo_permissions")
  sectionId      String?       @map("section_id") @db.Uuid
  workload       Int           @default(0) @map("carga")
  rrCounter      Int           @default(0) @map("contador_rr")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  section                                    Section?                             @relation(fields: [sectionId], references: [id])
  createdTasks                               Task[]                               @relation("TaskCreador")
  ownedBrands                                Brand[]                              @relation("BrandResponsable")
  createdBrands                              Brand[]                              @relation("BrandCreador")
  createdShops                               Shop[]                               @relation("ShopCreador")
  createdApps                                Application[]                        @relation("AppCreador")
  createdSftpApps                            SftpApplication[]                    @relation("SftpAppCreator")
  createdStoreEmergencies                    StoreEmergency[]                     @relation("StoreEmergencyCreator")
  storeEmergencyEvents                       StoreEmergencyEvent[]                @relation("StoreEmergencyEventActor")
  createdForcedOpenOperations                ForcedOpenOperation[]                @relation("ForcedOpenOperationCreator")
  assignedSteps                              StepInstance[]
  stepCandidate                              StepDefinitionAccount[]
  ruleCandidate                              BrandAssignmentRuleAccount[]
  createdInvitations                         Invitation[]                         @relation("InvitacionCreador")
  usedInvitation                             Invitation?                          @relation("InvitacionCuenta")
  createdAutoTurnOffRules                    AutoTurnOffRule[]                    @relation("AutoTurnOffRuleCreator")
  updatedAutoTurnOffRules                    AutoTurnOffRule[]                    @relation("AutoTurnOffRuleUpdater")
  cancelledAutoTurnOffExecutions             AutoTurnOffExecution[]               @relation("AutoTurnOffExecutionCanceller")
  createdFileIntegrationRules                FileIntegrationRule[]                @relation("FileIntegrationRuleCreator")
  createdFileIntegrationRuns                 FileIntegrationExecution[]           @relation("FileIntegrationExecutionCreator")
  createdPromotionApiRuns                    PromotionApiExecution[]              @relation("PromotionApiExecutionCreator")
  createdTargetedMenuRules                   TargetedMenuRule[]                   @relation("TargetedMenuRuleCreator")
  updatedTargetedMenuRules                   TargetedMenuRule[]                   @relation("TargetedMenuRuleUpdater")
  createdTargetedMenuRuns                    TargetedMenuExecution[]              @relation("TargetedMenuExecutionCreator")
  createdMenuCopyRuns                        MenuCopyExecution[]                  @relation("MenuCopyExecutionCreator")
  createdMassiveRtboRuns                     MassiveRtboExecution[]               @relation("MassiveRtboExecutionCreator")
  createdDidiStoreBindingRuns                DidiStoreBindingExecution[]          @relation("DidiStoreBindingExecutionCreator")
  createdOfferMenuRules                      OfferMenuUploadRule[]                @relation("OfferMenuRuleCreator")
  updatedOfferMenuRules                      OfferMenuUploadRule[]                @relation("OfferMenuRuleUpdater")
  createdOfferMenuRuns                       OfferMenuUploadExecution[]           @relation("OfferMenuExecutionCreator")
  createdUpcActivityPriceRules               UpcActivityPriceRule[]               @relation("UpcActivityPriceRuleCreator")
  updatedUpcActivityPriceRules               UpcActivityPriceRule[]               @relation("UpcActivityPriceRuleUpdater")
  createdUpcActivityPriceRuns                UpcActivityPriceExecution[]          @relation("UpcActivityPriceExecutionCreator")
  accessProfile                              AccountAccessProfile?
  accessPermissionOverrides                  AccountPermissionOverride[]
  accessSectionScopes                        AccountSectionScope[]
  accessControlAudits                        AccessControlAudit[]                 @relation("AccessControlAuditActor")
  storeOnboardingControls                    StoreOnboardingControl[]             @relation("StoreOnboardingControlUpdater")
  storeOnboardingControlRevisions            StoreOnboardingControlRevision[]     @relation("StoreOnboardingControlRevisionActor")
  storeOnboardingRolloutDrafts               StoreOnboardingRolloutRevision[]     @relation("StoreOnboardingRolloutCreator")
  storeOnboardingProfileDrafts               StoreOnboardingNotificationProfile[] @relation("StoreOnboardingProfileCreator")
  createdStoreOnboardingRequests             StoreOnboardingRequest[]             @relation("StoreOnboardingRequestCreator")
  assignedStoreOnboardingConfigurationBriefs StoreOnboardingRequest[]             @relation("StoreOnboardingConfigurationBriefAssignee")
  preparedStoreOnboardingRequests            StoreOnboardingRequest[]             @relation("StoreOnboardingConfigurationPreparedBy")
  storeOnboardingTransitions                 StoreOnboardingTransition[]          @relation("StoreOnboardingTransitionActor")
  storeOnboardingAudits                      StoreOnboardingUnit[]                @relation("StoreOnboardingAuditor")
  storeOnboardingConfigurationAssignments    StoreOnboardingUnit[]                @relation("StoreOnboardingConfigurationAssignee")
  storeOnboardingCommercialAssignments       StoreOnboardingUnit[]                @relation("StoreOnboardingCommercialAssignee")
  storeOnboardingGoLiveAssignments           StoreOnboardingUnit[]                @relation("StoreOnboardingGoLiveAssignee")
  storeOnboardingGoLiveAttempts              StoreOnboardingGoLiveAttempt[]       @relation("StoreOnboardingGoLiveActor")

  @@index([sectionId])
  @@map("account")
}

// ---------------------- Templates (admin config) ---------------------------
model TaskTypeTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  taskTypeId String   @map("task_type_id") @db.Uuid
  name       String
  url        String
  tipo       String   @default("link")
  createdAt  DateTime @default(now()) @map("created_at")

  taskType TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)

  @@map("task_type_template")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("nombre")
  order     Int      @default(0) @map("orden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts             Account[]
  taskTypes            TaskType[]
  invitations          Invitation[]
  roleAccesses         RoleSectionAccess[]
  roleSectionProfiles  RoleSectionProfile[]  @relation("RoleSectionProfileHome")
  roleSectionScopes    RoleSectionScope[]    @relation("RoleSectionScopeTarget")
  accountSectionScopes AccountSectionScope[]

  @@map("section")
}

model TaskType {
  id          String    @id @default(uuid()) @db.Uuid
  sectionId   String    @map("section_id") @db.Uuid
  name        String    @map("nombre")
  descripcion String?
  schedulable Boolean   @default(false) @map("programable")
  active      Boolean   @default(true) @map("activo")
  order       Int       @default(0) @map("orden")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  section                       Section                          @relation(fields: [sectionId], references: [id])
  stepDefinitions               StepDefinition[]
  formFields                    FormField[]
  tasks                         Task[]
  templates                     TaskTypeTemplate[]
  storeOnboardingSourceRollouts StoreOnboardingRolloutSource[]   @relation("StoreOnboardingSourceTaskType")
  storeOnboardingBrandRollouts  StoreOnboardingRolloutRevision[] @relation("StoreOnboardingBrandTaskType")

  @@index([sectionId])
  @@map("task_type")
}

model RoleSectionAccess {
  role      AccountRole @map("rol")
  sectionId String      @map("section_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([role, sectionId])
  @@index([sectionId])
  @@map("role_section_access")
}

model RolePermission {
  role       AccountRole @map("rol")
  permission String      @map("permiso")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@id([role, permission])
  @@index([permission])
  @@map("role_permission")
}

model RoleSectionProfile {
  role                AccountRole @map("rol")
  sectionId           String      @map("section_id") @db.Uuid
  customSectionAccess Boolean     @default(false) @map("custom_section_access")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  section             Section                         @relation("RoleSectionProfileHome", fields: [sectionId], references: [id], onDelete: Cascade)
  permissionOverrides RoleSectionPermissionOverride[]
  sectionScopes       RoleSectionScope[]

  @@id([role, sectionId])
  @@index([sectionId])
  @@map("role_section_profile")
}

model RoleSectionPermissionOverride {
  role       AccountRole @map("rol")
  sectionId  String      @map("section_id") @db.Uuid
  permission String      @map("permiso")
  allowed    Boolean     @map("permitido")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  profile RoleSectionProfile @relation(fields: [role, sectionId], references: [role, sectionId], onDelete: Cascade)

  @@id([role, sectionId, permission])
  @@index([permission])
  @@map("role_section_permission_override")
}

model RoleSectionScope {
  role             AccountRole @map("rol")
  profileSectionId String      @map("profile_section_id") @db.Uuid
  allowedSectionId String      @map("allowed_section_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  profile        RoleSectionProfile @relation(fields: [role, profileSectionId], references: [role, sectionId], onDelete: Cascade)
  allowedSection Section            @relation("RoleSectionScopeTarget", fields: [allowedSectionId], references: [id], onDelete: Cascade)

  @@id([role, profileSectionId, allowedSectionId])
  @@index([allowedSectionId])
  @@map("role_section_scope")
}

model AccountAccessProfile {
  accountId           String   @id @map("account_id") @db.Uuid
  customSectionAccess Boolean  @default(false) @map("custom_section_access")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_access_profile")
}

model AccountPermissionOverride {
  accountId  String   @map("account_id") @db.Uuid
  permission String   @map("permiso")
  allowed    Boolean  @map("permitido")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, permission])
  @@index([permission])
  @@map("account_permission_override")
}

model AccountSectionScope {
  accountId String   @map("account_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([accountId, sectionId])
  @@index([sectionId])
  @@map("account_section_scope")
}

model AccessControlAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  scopeType String   @map("scope_type")
  scopeKey  String   @map("scope_key")
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor Account @relation("AccessControlAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([scopeType, scopeKey])
  @@map("access_control_audit")
}

model Handler {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @map("nombre")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepDefinitions StepDefinition[]

  @@map("handler")
}

model StepDefinition {
  id                 String             @id @default(uuid()) @db.Uuid
  taskTypeId         String             @map("task_type_id") @db.Uuid
  name               String             @map("nombre")
  order              Int                @map("orden")
  executionType      ExecutionType      @map("tipo_ejecucion")
  action             String?            @map("accion")
  assignmentStrategy AssignmentStrategy @map("estrategia_asignacion")
  weight             Int                @default(1) @map("peso")
  handlerId          String?            @map("handler_id") @db.Uuid
  bpoCount           Int                @default(1) @map("bpo_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  taskType      TaskType                @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  handler       Handler?                @relation(fields: [handlerId], references: [id])
  stepWebhooks  StepWebhook[]
  candidates    StepDefinitionAccount[]
  stepInstances StepInstance[]

  @@unique([taskTypeId, order])
  @@index([taskTypeId])
  @@map("step_definition")
}

// Pool of candidates to assign the step (1 if fixed, multiple if RR / by weight).
model StepDefinitionAccount {
  stepDefinitionId String @map("step_definition_id") @db.Uuid
  accountId        String @map("account_id") @db.Uuid

  stepDefinition StepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [accountId], references: [id])

  @@id([stepDefinitionId, accountId])
  @@map("step_definition_account")
}

model FormField {
  id           String        @id @default(uuid()) @db.Uuid
  taskTypeId   String        @map("task_type_id") @db.Uuid
  label        String        @map("etiqueta")
  tipo         FormFieldTipo
  required     Boolean       @default(false) @map("requerido")
  multiple     Boolean       @default(false)
  options      Json?         @map("opciones")
  order        Int           @map("orden")
  filteredById String?       @map("filtra_por_field") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  taskType   TaskType    @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  filteredBy FormField?  @relation("FormFieldFiltro", fields: [filteredById], references: [id])
  filtered   FormField[] @relation("FormFieldFiltro")
  formValues FormValue[]

  @@unique([taskTypeId, order])
  @@index([taskTypeId])
  @@map("form_field")
}

// ---------------------------- Webhooks -------------------------------------
model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("nombre")
  url       String
  isAlerts  Boolean  @default(false) @map("es_alertas")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepWebhooks                        StepWebhook[]
  brandWebhooks                       BrandWebhook[]
  autoOpenPools                       AutoOpenPool[]
  autoTurnOffPools                    AutoTurnOffPool[]
  storeOnboardingNotificationProfiles StoreOnboardingNotificationProfile[]

  @@map("webhook")
}

model StepWebhook {
  id               String         @id @default(uuid()) @db.Uuid
  stepDefinitionId String         @map("step_definition_id") @db.Uuid
  webhookId        String         @map("webhook_id") @db.Uuid
  events           WebhookEvent[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  stepDefinition StepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)
  webhook        Webhook        @relation(fields: [webhookId], references: [id])

  @@unique([stepDefinitionId, webhookId])
  @@index([stepDefinitionId])
  @@map("step_webhook")
}

// ---------------------------- Catalog -------------------------------------
model Application {
  id                         String                  @id @default(uuid()) @db.Uuid
  appId                      String                  @unique @map("app_id")
  appName                    String                  @map("app_name")
  country                    Country
  appSecret                  String                  @map("app_secret") // ENCRYPTED at rest; never expose
  didiBindingEnvironment     DidiBindingEnvironment? @map("didi_binding_environment")
  orderWebhookTokenEncrypted String?                 @map("order_webhook_token_encrypted") @db.Text
  orderWebhookTokenHash      String?                 @unique @map("order_webhook_token_hash")
  orderWebhookCreatedAt      DateTime?               @map("order_webhook_created_at") @db.Timestamptz
  orderWebhookRotatedAt      DateTime?               @map("order_webhook_rotated_at") @db.Timestamptz
  orderWebhookDisabledAt     DateTime?               @map("order_webhook_disabled_at") @db.Timestamptz
  createdById                String?                 @map("created_by") @db.Uuid
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  deletedAt                  DateTime?               @map("deleted_at")

  createdBy                  Account?                    @relation("AppCreador", fields: [createdById], references: [id])
  brands                     Brand[]
  sourceMenuCopyExecutions   MenuCopyExecution[]         @relation("MenuCopySourceApplication")
  targetMenuCopyExecutions   MenuCopyExecution[]         @relation("MenuCopyTargetApplication")
  massiveRtboExecutions      MassiveRtboExecution[]
  didiStoreBindingExecutions DidiStoreBindingExecution[]
  offerMenuUploadRules       OfferMenuUploadRule[]
  upcActivityPriceRules      UpcActivityPriceRule[]
  didiOrderWebhookEvents     DidiOrderWebhookEvent[]
  didiOrderWebhookRequests   DidiOrderWebhookRequest[]

  @@unique([id, country]) // target of composite FK (see constraints.sql)
  @@map("application")
}

model SftpApplication {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  host        String
  port        Int       @default(22)
  username    String
  password    String // encrypted at rest; never expose
  rootPath    String?   @map("root_path")
  brandId     String?   @map("brand_id") @db.Uuid
  active      Boolean   @default(true)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy              Account?                @relation("SftpAppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  fileIntegrationRules   FileIntegrationRule[]
  storePromotions        StorePromotion[]
  promotionShopSnapshots PromotionShopSnapshot[]
  offerMenuUploadRules   OfferMenuUploadRule[]

  @@index([active])
  @@index([brandId])
  @@map("sftp_application")
}

model Brand {
  id              String           @id @default(uuid()) @db.Uuid
  brandId         String           @unique @map("brand_id")
  brandName       String           @map("brand_name")
  country         Country
  kaType          KaType           @map("ka_type")
  category        String?
  menuIntegration MenuIntegration? @map("menu_integration")
  pickingMode     PickingMode?     @map("picking_mode")
  paymentMode     PaymentMode?     @map("payment_mode")
  ownerId         String?          @map("responsable_id") @db.Uuid
  applicationId   String?          @map("application_id") @db.Uuid
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  owner                       Account?                     @relation("BrandResponsable", fields: [ownerId], references: [id])
  createdBy                   Account?                     @relation("BrandCreador", fields: [createdById], references: [id])
  application                 Application?                 @relation(fields: [applicationId], references: [id])
  webhooks                    BrandWebhook[]
  shops                       Shop[]
  tasks                       Task[]
  formValues                  FormValue[]
  autoOpenPoolBrands          AutoOpenPoolBrand[]
  autoOpenPoolBrandExclusions AutoOpenPoolBrandExclusion[]
  autoFetchPoolBrands         AutoFetchPoolBrand[]
  autoTurnOffRules            AutoTurnOffRule[]
  storeEmergencies            StoreEmergency[]
  forcedOpenOperations        ForcedOpenOperation[]
  items                       BrandItem[]
  shopItems                   BrandShopItem[]
  menuCategories              BrandMenuCategory[]
  sftpApplications            SftpApplication[]
  promotionApiExecutions      PromotionApiExecution[]
  targetedMenuRules           TargetedMenuRule[]
