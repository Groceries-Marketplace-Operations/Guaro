  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  brand     Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy Account                @relation("StoreEmergencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targets   StoreEmergencyTarget[]
  events    StoreEmergencyEvent[]

  @@index([brandId, createdAt])
  @@index([status, endsAt])
  @@map("store_emergency")
}

model StoreEmergencyTarget {
  id              String    @id @default(uuid()) @db.Uuid
  emergencyId     String    @map("emergency_id") @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  offlineStatus   String    @default("pending") @map("offline_status")
  restoreStatus   String    @default("pending") @map("restore_status")
  offlineError    String?   @map("offline_error") @db.Text
  restoreError    String?   @map("restore_error") @db.Text
  offlineAttempts Int       @default(0) @map("offline_attempts")
  restoreAttempts Int       @default(0) @map("restore_attempts")
  offlineAt       DateTime? @map("offline_at") @db.Timestamptz
  restoredAt      DateTime? @map("restored_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  emergency StoreEmergency        @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  events    StoreEmergencyEvent[]

  @@unique([emergencyId, shopId])
  @@index([emergencyId, offlineStatus])
  @@index([emergencyId, restoreStatus])
  @@map("store_emergency_target")
}

model StoreEmergencyEvent {
  id          String   @id @default(uuid()) @db.Uuid
  emergencyId String   @map("emergency_id") @db.Uuid
  targetId    String?  @map("target_id") @db.Uuid
  type        String   @db.VarChar(64)
  phase       String   @db.VarChar(24)
  outcome     String?  @db.VarChar(24)
  source      String   @db.VarChar(24)
  actorId     String?  @map("actor_id") @db.Uuid
  attempt     Int?
  message     String?  @db.Text
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  emergency StoreEmergency        @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  target    StoreEmergencyTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  actor     Account?              @relation("StoreEmergencyEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([emergencyId, occurredAt, id])
  @@index([targetId, occurredAt])
  @@index([emergencyId, phase, occurredAt])
  @@map("store_emergency_event")
}

// -------------------- Integrations: forced store opening -------------------
