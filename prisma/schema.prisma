  mode               String // all_brand | shop_list
  requestedIds       String[]  @default([]) @map("requested_shop_ids")
  reason             String    @db.VarChar(500)
  endsAt             DateTime  @map("ends_at") @db.Timestamptz
  status             String    @default("pending")
  createdById        String    @map("created_by_id") @db.Uuid
  shutdownQueuedAt   DateTime? @map("shutdown_queued_at") @db.Timestamptz
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  shutdownFinishedAt DateTime? @map("shutdown_finished_at") @db.Timestamptz
  offlineAt          DateTime? @map("offline_at") @db.Timestamptz
  restoreRequestedAt DateTime? @map("restore_requested_at") @db.Timestamptz
  restoreQueuedAt    DateTime? @map("restore_queued_at") @db.Timestamptz
  restoreStartedAt   DateTime? @map("restore_started_at") @db.Timestamptz
  restoreFinishedAt  DateTime? @map("restore_finished_at") @db.Timestamptz
  restoredAt         DateTime? @map("restored_at") @db.Timestamptz
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz
