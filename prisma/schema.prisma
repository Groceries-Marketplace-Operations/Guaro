// ============================================================================
// Prisma Schema — Task / Workflows System
// Source of truth. Equivalent to schema.sql + 002.
//
// Notes:
//   - updated_at is managed with @updatedAt (app-level), not a DB trigger.
//   - CHECK constraints and the composite FK for country (same country app<->brand)
//     are not expressed by Prisma: they go in constraints.sql, run AFTER migrate.
//   - step_definition_account added: pool of candidates to assign a step
//     (1 if fixed, multiple if RR / by_weight).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------- Enums ----------------------------------------
enum Country {
  CO
  MX
  CR
}

enum AccountRole {
  user
  bpo
  admin
  super_admin
  director

  @@map("AccountRol")
}

enum ExecutionType {
  manual_external
  manual_internal
  automatic

  @@map("TipoEjecucion")
}

enum AssignmentStrategy {
  fixed
  round_robin
  by_weight // on hold — not used in code; kept for DB compatibility
  brand_assignment // assign via BrandAssignmentRule (ka_type × country)
  manual // admin selects BPO at runtime
  same_previous_step // assign the same BPO who worked the previous step

  @@map("EstrategiaAsignacion")
}

enum AssignmentMode {
  fixed
  round_robin

  @@map("AsignacionModo")
}

enum FormFieldTipo {
  link
  link_spreadsheet
  texto
  text_box // multi-line free text area
  numero
  select
  select_brand
  multiple_brands // multi-select: one FormValue row per brand
  select_store
  select_ka_type // dropdown populated from AppConfig category=ka_type
  select_country // dropdown populated from AppConfig category=country
  select_biz_category // dropdown populated from AppConfig category=biz_category
  file // Excel upload (.xlsx/.xls); stored as temp filename, deleted after handler runs
}

enum WebhookEvent {
  on_start
  on_complete
  on_fail
  on_assignment
  on_blocked

  @@map("WebhookEvento")
}

enum TaskStatus {
  scheduled
  pending
  assigned
  in_progress
  blocked
  failed
  done

  @@map("TaskEstado")
}

enum StepStatus {
  pending
  in_progress
  blocked
  failed
  done
  cancelled

  @@map("StepEstado")
}

enum StepFailureReason {
  system_timed_out
  bpo_timed_out
  no_bpo
  error_handler

  @@map("StepMotivoFallo")
}

enum KaType {
  KA
  CKA
  SME
}

enum MenuIntegration {
  api
  api_whitelist
  sftp
  spreadsheets
  bapp
}

enum PickingMode {
  merchant_picking_bapp
  merchant_picking_dapp
  dos_en_uno
}

enum PaymentMode {
  food_mode
  prepaid_card
  qr_code
}

enum ShopStatus {
  lead
  application
  integrated
  online
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("DiaSemana")
}

enum AutoOpenStatus {
  pending
  running
  done
  partial_success
  failed
  cancelled

  @@map("AutoOpenEstado")
}

enum AutoFetchKind {
  stores
  menu
}

enum FileIntegrationKind {
  complex_promotion_reader
  price_filter
}

enum PromotionApiMode {
  dry_run
  live
}

// ---------------------------- Actors ---------------------------------------
model Account {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @map("nombre")
  email          String        @unique
  googleSub      String?       @unique @map("google_sub")
  roles          AccountRole[]
  adminModules   String[]      @default([]) @map("admin_modules")
  bpoPermissions String[]      @default([]) @map("bpo_permissions")
  sectionId      String?       @map("section_id") @db.Uuid
  workload       Int           @default(0) @map("carga")
  rrCounter      Int           @default(0) @map("contador_rr")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  section                        Section?                     @relation(fields: [sectionId], references: [id])
  createdTasks                   Task[]                       @relation("TaskCreador")
  ownedBrands                    Brand[]                      @relation("BrandResponsable")
  createdBrands                  Brand[]                      @relation("BrandCreador")
  createdShops                   Shop[]                       @relation("ShopCreador")
  createdApps                    Application[]                @relation("AppCreador")
  createdSftpApps                SftpApplication[]            @relation("SftpAppCreator")
  createdStoreEmergencies        StoreEmergency[]             @relation("StoreEmergencyCreator")
  createdForcedOpenOperations    ForcedOpenOperation[]        @relation("ForcedOpenOperationCreator")
  assignedSteps                  StepInstance[]
  stepCandidate                  StepDefinitionAccount[]
  ruleCandidate                  BrandAssignmentRuleAccount[]
  createdInvitations             Invitation[]                 @relation("InvitacionCreador")
  usedInvitation                 Invitation?                  @relation("InvitacionCuenta")
  createdAutoTurnOffRules        AutoTurnOffRule[]            @relation("AutoTurnOffRuleCreator")
  updatedAutoTurnOffRules        AutoTurnOffRule[]            @relation("AutoTurnOffRuleUpdater")
  cancelledAutoTurnOffExecutions AutoTurnOffExecution[]       @relation("AutoTurnOffExecutionCanceller")
  createdFileIntegrationRules    FileIntegrationRule[]        @relation("FileIntegrationRuleCreator")
  createdFileIntegrationRuns     FileIntegrationExecution[]   @relation("FileIntegrationExecutionCreator")
  createdPromotionApiRuns        PromotionApiExecution[]      @relation("PromotionApiExecutionCreator")

  @@index([sectionId])
  @@map("account")
}

// ---------------------- Templates (admin config) ---------------------------
model TaskTypeTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  taskTypeId String   @map("task_type_id") @db.Uuid
  name       String
  url        String
  tipo       String   @default("link")
  createdAt  DateTime @default(now()) @map("created_at")

  taskType TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)

  @@map("task_type_template")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("nombre")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts    Account[]
  taskTypes   TaskType[]
  invitations Invitation[]

  @@map("section")
}

model TaskType {
  id          String    @id @default(uuid()) @db.Uuid
  sectionId   String    @map("section_id") @db.Uuid
  name        String    @map("nombre")
  descripcion String?
  schedulable Boolean   @default(false) @map("programable")
  active      Boolean   @default(true) @map("activo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  section         Section            @relation(fields: [sectionId], references: [id])
  stepDefinitions StepDefinition[]
  formFields      FormField[]
  tasks           Task[]
  templates       TaskTypeTemplate[]

  @@index([sectionId])
  @@map("task_type")
}

model Handler {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @map("nombre")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepDefinitions StepDefinition[]

  @@map("handler")
}

model StepDefinition {
  id                 String             @id @default(uuid()) @db.Uuid
  taskTypeId         String             @map("task_type_id") @db.Uuid
  name               String             @map("nombre")
  order              Int                @map("orden")
  executionType      ExecutionType      @map("tipo_ejecucion")
  action             String?            @map("accion")
  assignmentStrategy AssignmentStrategy @map("estrategia_asignacion")
  weight             Int                @default(1) @map("peso")
  handlerId          String?            @map("handler_id") @db.Uuid
  bpoCount           Int                @default(1) @map("bpo_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  taskType      TaskType                @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  handler       Handler?                @relation(fields: [handlerId], references: [id])
  stepWebhooks  StepWebhook[]
  candidates    StepDefinitionAccount[]
  stepInstances StepInstance[]

  @@unique([taskTypeId, order])
  @@index([taskTypeId])
  @@map("step_definition")
}

// Pool of candidates to assign the step (1 if fixed, multiple if RR / by weight).
model StepDefinitionAccount {
  stepDefinitionId String @map("step_definition_id") @db.Uuid
  accountId        String @map("account_id") @db.Uuid

  stepDefinition StepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [accountId], references: [id])

  @@id([stepDefinitionId, accountId])
  @@map("step_definition_account")
}

model FormField {
  id           String        @id @default(uuid()) @db.Uuid
  taskTypeId   String        @map("task_type_id") @db.Uuid
  label        String        @map("etiqueta")
  tipo         FormFieldTipo
  required     Boolean       @default(false) @map("requerido")
  multiple     Boolean       @default(false)
  options      Json?         @map("opciones")
  order        Int           @map("orden")
  filteredById String?       @map("filtra_por_field") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  taskType   TaskType    @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  filteredBy FormField?  @relation("FormFieldFiltro", fields: [filteredById], references: [id])
  filtered   FormField[] @relation("FormFieldFiltro")
  formValues FormValue[]

  @@unique([taskTypeId, order])
  @@index([taskTypeId])
  @@map("form_field")
}

// ---------------------------- Webhooks -------------------------------------
model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("nombre")
  url       String
  isAlerts  Boolean  @default(false) @map("es_alertas")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepWebhooks     StepWebhook[]
  brandWebhooks    BrandWebhook[]
  autoOpenPools    AutoOpenPool[]
  autoTurnOffPools AutoTurnOffPool[]

  @@map("webhook")
}

model StepWebhook {
  id               String         @id @default(uuid()) @db.Uuid
  stepDefinitionId String         @map("step_definition_id") @db.Uuid
  webhookId        String         @map("webhook_id") @db.Uuid
  events           WebhookEvent[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  stepDefinition StepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)
  webhook        Webhook        @relation(fields: [webhookId], references: [id])

  @@unique([stepDefinitionId, webhookId])
  @@index([stepDefinitionId])
  @@map("step_webhook")
}

// ---------------------------- Catalog -------------------------------------
model Application {
  id          String    @id @default(uuid()) @db.Uuid
  appId       String    @unique @map("app_id")
  appName     String    @map("app_name")
  country     Country
  appSecret   String    @map("app_secret") // ENCRYPTED at rest; never expose
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy Account? @relation("AppCreador", fields: [createdById], references: [id])
  brands    Brand[]

  @@unique([id, country]) // target of composite FK (see constraints.sql)
  @@map("application")
}

model SftpApplication {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  host        String
  port        Int       @default(22)
  username    String
  password    String // encrypted at rest; never expose
  rootPath    String?   @map("root_path")
  active      Boolean   @default(true)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy Account? @relation("SftpAppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fileIntegrationRules FileIntegrationRule[]

  @@index([active])
  @@map("sftp_application")
}

model Brand {
  id              String           @id @default(uuid()) @db.Uuid
  brandId         String           @unique @map("brand_id")
  brandName       String           @map("brand_name")
  country         Country
  kaType          KaType           @map("ka_type")
  category        String?
  menuIntegration MenuIntegration? @map("menu_integration")
  pickingMode     PickingMode?     @map("picking_mode")
  paymentMode     PaymentMode?     @map("payment_mode")
  ownerId         String?          @map("responsable_id") @db.Uuid
  applicationId   String?          @map("application_id") @db.Uuid
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  owner                Account?              @relation("BrandResponsable", fields: [ownerId], references: [id])
  createdBy            Account?              @relation("BrandCreador", fields: [createdById], references: [id])
  application          Application?          @relation(fields: [applicationId], references: [id])
  webhooks             BrandWebhook[]
  shops                Shop[]
  tasks                Task[]
  formValues           FormValue[]
  autoOpenPoolBrands   AutoOpenPoolBrand[]
  autoFetchPoolBrands  AutoFetchPoolBrand[]
  autoTurnOffRules     AutoTurnOffRule[]
  storeEmergencies     StoreEmergency[]
  forcedOpenOperations ForcedOpenOperation[]
  items                BrandItem[]
  promotionApiExecutions PromotionApiExecution[]

  @@index([ownerId])
  @@index([applicationId])
  @@map("brand")
}

model BrandWebhook {
  id        String   @id @default(uuid()) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  webhookId String   @map("webhook_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@unique([brandId, webhookId])
  @@map("brand_webhook")
}

model Shop {
  id             String     @id @default(uuid()) @db.Uuid
  shopId         String     @unique @map("shop_id")
  appShopId      String     @map("app_shop_id")
  name           String?
  brandId        String     @map("brand_id") @db.Uuid
  latitude       Decimal?   @db.Decimal(9, 6)
  longitude      Decimal?   @db.Decimal(9, 6)
  city           String?
  address        String?    @db.Text
  status         ShopStatus @default(lead)
  createdById    String?    @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  menuSyncStatus String     @default("never") @map("menu_sync_status")
  menuSyncedAt   DateTime?  @map("menu_synced_at") @db.Timestamptz
  menuSyncError  String?    @map("menu_sync_error") @db.Text
  menuItemCount  Int        @default(0) @map("menu_item_count")

  brand             Brand                  @relation(fields: [brandId], references: [id])
  createdBy         Account?               @relation("ShopCreador", fields: [createdById], references: [id])
  schedules         Schedule[]
  taskShops         TaskShop[]
  formValues        FormValue[]
  emergencies       StoreEmergencyTarget[]
  forcedOpenTargets ForcedOpenTarget[]
  promotionApiExecutions PromotionApiExecution[]

  @@unique([brandId, appShopId])
  @@index([brandId])
  @@map("shop")
}

model BrandItem {
  id           String   @id @default(uuid()) @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  name         String
  upc          String?
  appItemId    String   @map("app_item_id")
  imageUrl     String?  @map("image_url")
  sourceShopId String?  @map("source_shop_id")
  sourceCity   String?  @map("source_city")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, appItemId])
  @@index([brandId, upc])
  @@index([brandId, name])
  @@map("brand_item")
}

model Schedule {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  day       DayOfWeek @map("dia")
  openTime  DateTime  @map("apertura") @db.Time
  closeTime DateTime  @map("cierre") @db.Time
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("schedule")
}

// ---------------- Brand owner assignment -----------------------------------
model BrandAssignmentRule {
  id        String         @id @default(uuid()) @db.Uuid
  kaType    KaType         @map("ka_type")
  country   Country
  modo      AssignmentMode
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  candidates BrandAssignmentRuleAccount[]

  @@unique([kaType, country])
  @@map("brand_assignment_rule")
}

model BrandAssignmentRuleAccount {
  ruleId    String @map("rule_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  rule    BrandAssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  account Account             @relation(fields: [accountId], references: [id])

  @@id([ruleId, accountId])
  @@map("brand_assignment_rule_account")
}

// ---------------------------- Execution ------------------------------------
model Task {
  id             String     @id @default(uuid()) @db.Uuid
  taskTypeId     String     @map("task_type_id") @db.Uuid
  brandId        String?    @map("brand_id") @db.Uuid
  createdById    String     @map("created_by") @db.Uuid
  status         TaskStatus @default(pending) @map("estado")
  scheduledStart DateTime?  @map("programado_inicio")
  scheduledEnd   DateTime?  @map("programado_fin")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  taskType      TaskType       @relation(fields: [taskTypeId], references: [id])
  brand         Brand?         @relation(fields: [brandId], references: [id])
  createdBy     Account        @relation("TaskCreador", fields: [createdById], references: [id])
  stepInstances StepInstance[]
  formValues    FormValue[]
  taskShops     TaskShop[]

  @@index([taskTypeId])
  @@index([brandId])
  @@index([createdById])
  @@index([status])
  @@map("task")
}

model TaskShop {
  taskId String @map("task_id") @db.Uuid
  shopId String @map("shop_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id])

  @@id([taskId, shopId])
  @@map("task_shop")
}

model StepInstance {
  id               String             @id @default(uuid()) @db.Uuid
  taskId           String             @map("task_id") @db.Uuid
  stepDefinitionId String             @map("step_definition_id") @db.Uuid
  status           StepStatus         @default(pending) @map("estado")
  assignedToId     String?            @map("asignado_id") @db.Uuid
  result           Json?              @map("resultado")
  note             String?            @map("nota")
  failureReason    StepFailureReason? @map("motivo_fallo")
  startedAt        DateTime?          @map("started_at")
  workedSeconds    Int?               @map("worked_seconds")
  completedAt      DateTime?          @map("completado_en")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepDefinition StepDefinition @relation(fields: [stepDefinitionId], references: [id])
  assignedTo     Account?       @relation(fields: [assignedToId], references: [id])

  @@index([taskId])
  @@index([assignedToId])
  @@map("step_instance")
}

model FormValue {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  formFieldId String   @map("form_field_id") @db.Uuid
  valor       String?
  brandId     String?  @map("brand_id") @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  formField FormField @relation(fields: [formFieldId], references: [id])
  brand     Brand?    @relation(fields: [brandId], references: [id])
  shop      Shop?     @relation(fields: [shopId], references: [id])

  @@index([taskId])
  @@map("form_value")
}

// -------------------- Task archive ------------------------------------------
model TaskArchive {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  taskTypeName  String   @map("task_type_name")
  taskTypeId    String   @map("task_type_id") @db.Uuid
  sectionId     String?  @map("section_id") @db.Uuid
  brandName     String?  @map("brand_name")
  brandRef      String?  @map("brand_ref")
  country       String?
  createdByName String?  @map("created_by_name")
  status        String
  stepsTotal    Int      @default(0) @map("steps_total")
  stepsDone     Int      @default(0) @map("steps_done")
  stepsFailed   Int      @default(0) @map("steps_failed")
  taskCreatedAt DateTime @map("task_created_at") @db.Timestamptz
  taskUpdatedAt DateTime @map("task_updated_at") @db.Timestamptz
  archivedAt    DateTime @default(now()) @map("archived_at") @db.Timestamptz

  @@index([taskTypeId])
  @@index([sectionId])
  @@index([taskCreatedAt])
  @@map("task_archive")
}

// -------------------- App-level configuration --------------------------------
// Stores which enum values are active + display labels.
// Categories: country, menu_integration, picking_mode, payment_mode, ka_type
model AppConfigOption {
  id        String   @id @default(uuid()) @db.Uuid
  category  String   @map("categoria")
  value     String   @map("valor")
  label     String   @map("etiqueta")
  active    Boolean  @default(true) @map("activo")
  order     Int      @default(0) @map("orden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, value])
  @@index([category])
  @@map("app_config_option")
}

// -------------------- Integrations: Auto Open Stores -------------------------
model AutoOpenPool {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  country        Country
  active         Boolean  @default(true)
  executionHours Int[]    @map("execution_hours")
  timezone       String   @default("UTC")
  webhookId      String?  @map("webhook_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  webhook    Webhook?            @relation(fields: [webhookId], references: [id])
  brands     AutoOpenPoolBrand[]
  executions AutoOpenExecution[]

  @@map("auto_open_pool")
}

model AutoOpenPoolBrand {
  poolId  String @map("pool_id") @db.Uuid
  brandId String @map("brand_id") @db.Uuid

  pool  AutoOpenPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  brand Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([poolId, brandId])
  @@map("auto_open_pool_brand")
}

model AutoOpenExecution {
  id          String         @id @default(uuid()) @db.Uuid
  poolId      String         @map("pool_id") @db.Uuid
  status      AutoOpenStatus @default(pending)
  startedAt   DateTime?      @map("started_at") @db.Timestamptz
  finishedAt  DateTime?      @map("finished_at") @db.Timestamptz
  totalShops  Int            @default(0) @map("total_shops")
  shopsOpened Int            @default(0) @map("shops_opened")
  logs        Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  pool AutoOpenPool @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@map("auto_open_execution")
}

// -------------------- Integrations: Auto Turn Off Items ---------------------
model AutoTurnOffPool {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  country   Country
  active    Boolean  @default(true)
  webhookId String?  @map("webhook_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  webhook    Webhook?               @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  rules      AutoTurnOffRule[]
  executions AutoTurnOffExecution[]

  @@map("auto_turn_off_pool")
}

// -------------------- Integrations: automated catalog fetches --------------
model AutoFetchPool {
  id              String        @id @default(uuid()) @db.Uuid
  kind            AutoFetchKind
  country         Country
  name            String
  active          Boolean       @default(true)
  executionHour   Int           @default(2) @map("execution_hour")
  executionMinute Int           @default(0) @map("execution_minute")
  executionTimes  String[]      @default([]) @map("execution_times")
  timezone        String
  nextRunAt       DateTime      @map("next_run_at") @db.Timestamptz
  lastRunAt       DateTime?     @map("last_run_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  executions    AutoFetchExecution[]
  brandSettings AutoFetchPoolBrand[]

  @@unique([kind, country])
  @@index([active, nextRunAt])
  @@map("auto_fetch_pool")
}

model AutoFetchExecution {
  id                String         @id @default(uuid()) @db.Uuid
  poolId            String         @map("pool_id") @db.Uuid
  status            AutoOpenStatus @default(pending)
  trigger           String         @default("scheduled")
  startedAt         DateTime?      @map("started_at") @db.Timestamptz
  finishedAt        DateTime?      @map("finished_at") @db.Timestamptz
  totalBrands       Int            @default(0) @map("total_brands")
  brandsSucceeded   Int            @default(0) @map("brands_succeeded")
  totalShops        Int            @default(0) @map("total_shops")
  totalItems        Int            @default(0) @map("total_items")
  progressPercent   Int            @default(0) @map("progress_percent")
  currentBrand      String?        @map("current_brand")
  errorMessage      String?        @map("error_message") @db.Text
  requestedBrandIds String[]       @default([]) @map("requested_brand_ids")
  cancelledBrandIds String[]       @default([]) @map("cancelled_brand_ids")
  cancelRequested   Boolean        @default(false) @map("cancel_requested")
  logs              Json?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  pool AutoFetchPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId, createdAt])
  @@index([status])
  @@map("auto_fetch_execution")
}

model AutoFetchPoolBrand {
  id               String   @id @default(uuid()) @db.Uuid
  poolId           String   @map("pool_id") @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  active           Boolean  @default(true)
  manuallyIncluded Boolean  @default(false) @map("manually_included")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pool  AutoFetchPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([poolId, brandId])
  @@index([poolId, active])
  @@index([brandId])
  @@map("auto_fetch_pool_brand")
}

// -------------------- Integrations: SFTP files and promotions -------------
model FileIntegrationRule {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  kind              FileIntegrationKind
  country           Country?
  sftpApplicationId String              @map("sftp_application_id") @db.Uuid
  active            Boolean             @default(false)
  intervalMinutes   Int?                @map("interval_minutes")
  nextRunAt         DateTime?           @map("next_run_at") @db.Timestamptz
  lastRunAt         DateTime?           @map("last_run_at") @db.Timestamptz
  lastRemoteModifiedAt DateTime?        @map("last_remote_modified_at") @db.Timestamptz
  filePattern       String              @default("*") @map("file_pattern")
  sourceScope       String              @default("all") @map("source_scope")
  thresholdAmount   Decimal?            @map("threshold_amount") @db.Decimal(14, 2)
  delimiter         String?
  priceColumn       Int?                @map("price_column")
  maxFilesPerRun    Int                 @default(250) @map("max_files_per_run")
  createdById       String?             @map("created_by") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz

  sftpApplication SftpApplication           @relation(fields: [sftpApplicationId], references: [id])
  createdBy       Account?                  @relation("FileIntegrationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  executions      FileIntegrationExecution[]

  @@index([kind, active, nextRunAt])
  @@index([sftpApplicationId])
  @@map("file_integration_rule")
}

model FileIntegrationExecution {
  id              String         @id @default(uuid()) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  status          AutoOpenStatus @default(pending)
  trigger         String         @default("manual")
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz
  durationMs      Int?           @map("duration_ms")
  filesScanned    Int            @default(0) @map("files_scanned")
  filesProcessed  Int            @default(0) @map("files_processed")
  rowsRead        Int            @default(0) @map("rows_read")
  rowsKept        Int            @default(0) @map("rows_kept")
  rowsRemoved     Int            @default(0) @map("rows_removed")
  bytesRead       BigInt         @default(0) @map("bytes_read")
  currentFile     String?        @map("current_file")
  cancelRequested Boolean        @default(false) @map("cancel_requested")
  errorMessage    String?        @map("error_message") @db.Text
  result          Json?
  createdById     String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  rule      FileIntegrationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdBy Account?             @relation("FileIntegrationExecutionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@index([status])
  @@map("file_integration_execution")
}

model PromotionApiExecution {
  id           String           @id @default(uuid()) @db.Uuid
  brandId      String           @map("brand_id") @db.Uuid
  shopId       String           @map("shop_id") @db.Uuid
  mode         PromotionApiMode @default(dry_run)
  status       AutoOpenStatus   @default(pending)
  endpoint     String           @default("POST /v1/promo/promo/uploadGrocery")
  payload      Json
  response     Json?
  remoteTaskId String?          @map("remote_task_id")
  startedAt    DateTime?        @map("started_at") @db.Timestamptz
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz
  durationMs   Int?             @map("duration_ms")
  errorMessage String?          @map("error_message") @db.Text
  createdById  String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  brand     Brand   @relation(fields: [brandId], references: [id])
  shop      Shop    @relation(fields: [shopId], references: [id])
  createdBy Account? @relation("PromotionApiExecutionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([brandId, createdAt])
  @@index([shopId])
  @@index([status])
  @@map("promotion_api_execution")
}

model AutoTurnOffRule {
  id              String    @id @default(uuid()) @db.Uuid
  poolId          String    @map("pool_id") @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  name            String
  active          Boolean   @default(true)
  scheduleMode    String    @default("interval") @map("schedule_mode")
  intervalMinutes Int       @map("interval_minutes")
  executionTimes  String[]  @default([]) @map("execution_times")
  upcs            String[]
  shopIds         String[]  @map("shop_ids")
  resolvedShopIds Json?     @map("resolved_shop_ids")
  stockEndpoint   String    @default("setStock") @map("stock_endpoint")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz
  nextRunAt       DateTime  @map("next_run_at") @db.Timestamptz
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz
  createdById     String    @map("created_by_id") @db.Uuid
  updatedById     String    @map("updated_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  pool       AutoTurnOffPool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  brand      Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy  Account                @relation("AutoTurnOffRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  Account                @relation("AutoTurnOffRuleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  executions AutoTurnOffExecution[]

  @@index([poolId])
  @@index([brandId])
  @@index([active, nextRunAt])
  @@map("auto_turn_off_rule")
}

model AutoTurnOffExecution {
  id              String         @id @default(uuid()) @db.Uuid
  poolId          String         @map("pool_id") @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  status          AutoOpenStatus @default(pending)
  trigger         String         @default("scheduled")
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz
  totalShops      Int            @default(0) @map("total_shops")
  shopsSucceeded  Int            @default(0) @map("shops_succeeded")
  itemsTurnedOff  Int            @default(0) @map("items_turned_off")
  currentStep     String?        @map("current_step")
  progressCurrent Int            @default(0) @map("progress_current")
  progressTotal   Int            @default(0) @map("progress_total")
  progressPercent Int            @default(0) @map("progress_percent")
  errorMessage    String?        @map("error_message") @db.Text
  cancelledById   String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz
  logs            Json?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  pool        AutoTurnOffPool            @relation(fields: [poolId], references: [id], onDelete: Cascade)
  rule        AutoTurnOffRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  cancelledBy Account?                   @relation("AutoTurnOffExecutionCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  shops       AutoTurnOffShopExecution[]

  @@index([poolId])
  @@index([ruleId])
  @@index([createdAt])
  @@map("auto_turn_off_execution")
}

model AutoTurnOffShopExecution {
  id             String         @id @default(uuid()) @db.Uuid
  executionId    String         @map("execution_id") @db.Uuid
  shopId         String         @map("shop_id")
  appShopId      String?        @map("app_shop_id")
  status         AutoOpenStatus @default(pending)
  currentStep    String?        @map("current_step")
  itemsSucceeded Int            @default(0) @map("items_succeeded")
  itemsFailed    Int            @default(0) @map("items_failed")
  result         Json?
  startedAt      DateTime?      @map("started_at") @db.Timestamptz
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  execution AutoTurnOffExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, shopId])
  @@index([executionId, status])
  @@map("auto_turn_off_shop_execution")
}

// -------------------- Integrations: emergency store shutdowns --------------
model StoreEmergency {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  mode         String // all_brand | shop_list
  requestedIds String[]  @default([]) @map("requested_shop_ids")
  endsAt       DateTime  @map("ends_at") @db.Timestamptz
  status       String    @default("pending")
  createdById  String    @map("created_by_id") @db.Uuid
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  offlineAt    DateTime? @map("offline_at") @db.Timestamptz
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  brand     Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy Account                @relation("StoreEmergencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targets   StoreEmergencyTarget[]

  @@index([brandId, createdAt])
  @@index([status, endsAt])
  @@map("store_emergency")
}

model StoreEmergencyTarget {
  id            String    @id @default(uuid()) @db.Uuid
  emergencyId   String    @map("emergency_id") @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  offlineStatus String    @default("pending") @map("offline_status")
  restoreStatus String    @default("pending") @map("restore_status")
  offlineError  String?   @map("offline_error") @db.Text
  restoreError  String?   @map("restore_error") @db.Text
  offlineAt     DateTime? @map("offline_at") @db.Timestamptz
  restoredAt    DateTime? @map("restored_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  emergency StoreEmergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([emergencyId, shopId])
  @@index([emergencyId, offlineStatus])
  @@index([emergencyId, restoreStatus])
  @@map("store_emergency_target")
}

// -------------------- Integrations: forced store opening -------------------
model ForcedOpenOperation {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  mode         String // all_brand | shop_list
  requestedIds String[]  @default([]) @map("requested_shop_ids")
  status       String    @default("pending")
  totalShops   Int       @default(0) @map("total_shops")
  shopsOpened  Int       @default(0) @map("shops_opened")
  shopsFailed  Int       @default(0) @map("shops_failed")
  createdById  String    @map("created_by_id") @db.Uuid
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  brand     Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy Account            @relation("ForcedOpenOperationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targets   ForcedOpenTarget[]

  @@index([brandId, createdAt])
  @@index([status, createdAt])
  @@map("forced_open_operation")
}

model ForcedOpenTarget {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  status      String    @default("pending")
  error       String?   @db.Text
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  operation ForcedOpenOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([operationId, shopId])
  @@index([operationId, status])
  @@map("forced_open_target")
}

// -------------------------- Auth / invitations -----------------------------
model Invitation {
  id          String      @id @default(uuid()) @db.Uuid
  token       String      @unique
  rol         AccountRole
  sectionId   String?     @map("section_id") @db.Uuid
  createdById String      @map("created_by") @db.Uuid
  accountId   String?     @unique @map("account_id") @db.Uuid
  usedAt      DateTime?   @map("used_at")
  expiresAt   DateTime?   @map("expires_at")
  maxUses     Int?        @map("max_uses") // null = single-use (legacy)
  useCount    Int         @default(0) @map("use_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  section   Section? @relation(fields: [sectionId], references: [id])
  createdBy Account  @relation("InvitacionCreador", fields: [createdById], references: [id])
  account   Account? @relation("InvitacionCuenta", fields: [accountId], references: [id])

  @@index([sectionId])
  @@map("invitation")
}
